{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "demo", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
